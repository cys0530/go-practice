package main

import (
	"fmt"
)

func Sqrt(x float64) float64 {
	z := 1.0 // 1. 初始猜测值，通常设为 1.0

	// 2. 进行多次迭代（比如 10 次）来逼近真实结果
	for i := 0; i < 10; i++ {
		// 根据牛顿迭代公式调整 z
		z -= (z*z - x) / (2 * z)
		fmt.Printf("第 %d 次迭代，z 的值: %g\n", i+1, z)
	}
	return z
}

func main() {
	fmt.Println("最终结果:", Sqrt(2))
}
